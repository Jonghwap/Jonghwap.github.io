---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign default_changefreq = "monthly" %}
  {% assign default_priority = "0.6" %}

  {% for page in site.pages %}
    {% if page.sitemap != false and page.url != "/sitemap.xml" and page.url != "/robots.txt" %}
      <url>
        <loc>{{ site.url }}{{ site.baseurl }}{{ page.url | replace:'index.html','' }}</loc>
        {% if page.lastmod %}
          <lastmod>{{ page.lastmod | date_to_xmlschema }}</lastmod>
        {% endif %}
        <changefreq>{{ page.sitemap.changefreq | default: default_changefreq }}</changefreq>
        <priority>{{ page.sitemap.priority | default: default_priority }}</priority>
      </url>
    {% endif %}
  {% endfor %}
  
  {% for post in site.posts %}
    {% if post.sitemap != false %}
      <url>
        <loc>{{ site.url }}{{ site.baseurl }}{{ post.url }}</loc>
        <lastmod>{{ post.lastmod | default: post.date | date_to_xmlschema }}</lastmod>
        <changefreq>{{ post.sitemap.changefreq | default: "weekly" }}</changefreq>
        <priority>{{ post.sitemap.priority | default: "0.5" }}</priority>
      </url>
    {% endif %}
  {% endfor %}
</urlset>
